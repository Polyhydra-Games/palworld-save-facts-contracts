{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polyhydra-games.github.io/palworld-save-facts-contracts/schema/palworld-save-facts.v2.schema.json",
  "title": "Palworld Save Facts v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "snapshotId",
    "sourceDigest",
    "observedAt",
    "provenance",
    "completeness",
    "warnings",
    "domainCounts",
    "players", "pals", "world"
  ],
  "properties": {
    "schemaVersion": { "const": "palworld-save-facts/v2" },
    "snapshotId": { "type": "string", "minLength": 1 },
    "sourceDigest": { "type": "string", "minLength": 1 },
    "observedAt": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parserVersion", "decoderVersion", "gameVersion"],
      "properties": {
        "parserVersion": { "type": "string", "minLength": 1 },
        "decoderVersion": { "type": "string", "minLength": 1 },
        "gameVersion": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "completeness": {
      "type": "string",
      "enum": ["complete", "partial", "incomplete", "unknown"]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "domainCounts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "players": {
      "type": "array",
      "items": { "$ref": "#/$defs/player" }
    },
    "pals": {
      "type": "array",
      "items": { "$ref": "#/$defs/pal" }
    },
    "world": { "$ref": "#/$defs/world" }
  },
  "$defs": {
    "fieldState": { "type": "string", "enum": ["present", "absent", "unknown"] },
    "stringField": {
      "type": "object", "additionalProperties": false, "required": ["state", "value"],
      "properties": { "state": { "$ref": "#/$defs/fieldState" }, "value": { "type": ["string", "null"] } }
    },
    "integerField": {
      "type": "object", "additionalProperties": false, "required": ["state", "value"],
      "properties": { "state": { "$ref": "#/$defs/fieldState" }, "value": { "type": ["integer", "null"] } }
    },
    "stringListField": {
      "type": "object", "additionalProperties": false, "required": ["state", "values"],
      "properties": { "state": { "$ref": "#/$defs/fieldState" }, "values": { "type": "array", "items": { "type": "string" } } }
    },
    "timestampField": {
      "type": "object", "additionalProperties": false, "required": ["state", "value"],
      "properties": { "state": { "$ref": "#/$defs/fieldState" }, "value": { "type": ["string", "null"], "format": "date-time" } }
    },
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["snapshotLocalId"],
      "properties": { "snapshotLocalId": { "type": "string", "minLength": 1 } }
    },
    "positionField": {
      "type": "object", "additionalProperties": false, "required": ["state", "value"],
      "properties": {
        "state": { "$ref": "#/$defs/fieldState" },
        "value": { "type": ["object", "null"], "additionalProperties": false,
          "required": ["x", "y", "z"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } } }
      }
    },
    "player": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshotLocalId", "nativeId", "displayName", "guild", "level", "experience", "points", "technology", "recipes", "quests", "lastOnline", "inventoryReferences", "equipmentReferences", "position", "state"],
      "properties": {
        "snapshotLocalId": { "type": "string", "minLength": 1 },
        "nativeId": { "$ref": "#/$defs/stringField" }, "displayName": { "$ref": "#/$defs/stringField" }, "guild": { "$ref": "#/$defs/stringField" },
        "level": { "$ref": "#/$defs/integerField" }, "experience": { "$ref": "#/$defs/integerField" }, "points": { "$ref": "#/$defs/integerField" },
        "technology": { "$ref": "#/$defs/stringListField" }, "recipes": { "$ref": "#/$defs/stringListField" }, "quests": { "$ref": "#/$defs/stringListField" },
        "lastOnline": { "$ref": "#/$defs/timestampField" }, "inventoryReferences": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
        "equipmentReferences": { "type": "array", "items": { "$ref": "#/$defs/reference" } }, "position": { "$ref": "#/$defs/positionField" }, "state": { "$ref": "#/$defs/stringField" }
      }
    },
    "pal": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshotLocalId", "nativeId", "species", "nickname", "owner", "ownershipObservedAt", "firstObservedAt", "level", "experience", "rank", "gender", "traits", "ivStats", "souls", "passiveSkills", "activeSkills", "vitals", "workSuitability", "container", "slot", "party", "palbox", "base", "guild"],
      "properties": {
        "snapshotLocalId": { "type": "string", "minLength": 1 },
        "nativeId": { "$ref": "#/$defs/stringField" }, "species": { "$ref": "#/$defs/stringField" }, "nickname": { "$ref": "#/$defs/stringField" }, "owner": { "$ref": "#/$defs/stringField" },
        "ownershipObservedAt": { "$ref": "#/$defs/timestampField" }, "firstObservedAt": { "$ref": "#/$defs/timestampField" }, "level": { "$ref": "#/$defs/integerField" }, "experience": { "$ref": "#/$defs/integerField" }, "rank": { "$ref": "#/$defs/integerField" }, "gender": { "$ref": "#/$defs/stringField" }, "traits": { "$ref": "#/$defs/stringListField" }, "ivStats": { "type": "object", "additionalProperties": { "$ref": "#/$defs/integerField" } }, "souls": { "$ref": "#/$defs/integerField" }, "passiveSkills": { "$ref": "#/$defs/stringListField" }, "activeSkills": { "$ref": "#/$defs/stringListField" },
        "vitals": { "type": "object", "additionalProperties": false, "required": ["health", "sanity", "hunger", "friendship"], "properties": { "health": { "$ref": "#/$defs/integerField" }, "sanity": { "$ref": "#/$defs/integerField" }, "hunger": { "$ref": "#/$defs/integerField" }, "friendship": { "$ref": "#/$defs/integerField" } } },
        "workSuitability": { "$ref": "#/$defs/stringListField" }, "container": { "$ref": "#/$defs/stringField" }, "slot": { "$ref": "#/$defs/integerField" }, "party": { "$ref": "#/$defs/stringField" }, "palbox": { "$ref": "#/$defs/stringField" }, "base": { "$ref": "#/$defs/stringField" }, "guild": { "$ref": "#/$defs/stringField" }
      }
    },
    "worldEntity": {
      "type": "object", "additionalProperties": false, "required": ["snapshotLocalId", "kind", "name", "position", "references", "state"],
      "properties": { "snapshotLocalId": { "type": "string", "minLength": 1 }, "kind": { "$ref": "#/$defs/stringField" }, "name": { "$ref": "#/$defs/stringField" }, "position": { "$ref": "#/$defs/positionField" }, "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } }, "state": { "$ref": "#/$defs/stringField" } }
    },
    "world": {
      "type": "object", "additionalProperties": false,
      "required": ["families", "guilds", "settlements", "workers", "facilities", "structures", "containers", "itemSlots", "equipment", "mapObjects", "workState", "dungeons", "camps", "invaders", "oilRigs", "supplySystems"],
      "properties": {
        "families": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["family", "state", "warningCode"], "properties": { "family": { "type": "string" }, "state": { "type": "string", "enum": ["present", "absent", "unknown", "unsupported", "malformed"] }, "warningCode": { "type": ["string", "null"] } } } },
        "guilds": { "type": "array", "items": { "$ref": "#/$defs/worldEntity" } }, "settlements": { "type": "array", "items": { "$ref": "#/$defs/worldEntity" } }, "workers": { "type": "array", "items": { "$ref": "#/$defs/worldEntity" } }, "facilities": { "type": "array", "items": { "$ref": "#/$defs/worldEntity" } }, "structures": { "type": "array", "items": { "$ref": "#/$defs/worldEntity" } }, "containers": { "type": "array", "items": { "$ref": "#/$defs/worldEntity" } }, "itemSlots": { "type": "array", "items": { "$ref": "#/$defs/worldEntity" } }, "equipment": { "type": "array", "items": { "$ref": "#/$defs/worldEntity" } }, "mapObjects": { "type": "array", "items": { "$ref": "#/$defs/worldEntity" } }, "workState": { "type": "array", "items": { "$ref": "#/$defs/worldEntity" } }, "dungeons": { "type": "array", "items": { "$ref": "#/$defs/worldEntity" } }, "camps": { "type": "array", "items": { "$ref": "#/$defs/worldEntity" } }, "invaders": { "type": "array", "items": { "$ref": "#/$defs/worldEntity" } }, "oilRigs": { "type": "array", "items": { "$ref": "#/$defs/worldEntity" } }, "supplySystems": { "type": "array", "items": { "$ref": "#/$defs/worldEntity" } }
      }
    }
  }
}
